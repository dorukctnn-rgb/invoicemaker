<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= industry.title %></title>
<meta name="description" content="<%= industry.desc %>">
<link rel="canonical" href="<%= siteUrl %>/invoice-template-<%= industry.slug %>">
<meta property="og:type" content="website">
<meta property="og:title" content="<%= industry.title %>">
<meta property="og:description" content="<%= industry.desc %>">
<meta property="og:url" content="<%= siteUrl %>/invoice-template-<%= industry.slug %>">
<%- include('partials/site-head') %>
<%
  var pageUrl = siteUrl + '/invoice-template-' + industry.slug;
  var faqs = industry.custom === 'real-estate' ? [
    ['What should a real estate commission invoice include?', 'Your name and brokerage, licence number, the party paying (usually the other brokerage, the seller or the landlord), the property address, MLS or file number, sale price or rent, commission rate, any split or referral share, the closing date, the amount due and how to pay.'],
    ['How do I calculate the commission on the invoice?', 'Multiply the sale price by the commission rate, then by your share if the commission is split. Example: 450,000 x 3% = 13,500 gross commission; with a 25% referral share the referral invoice is 3,375. Show each step on the invoice so the payer can check it.'],
    ['When is a real estate commission invoice paid?', 'Usually at closing, out of the sale proceeds, as set out in the listing or buyer agreement. Put "Due at closing" and the closing date on the invoice and send it to whoever disburses the funds.'],
    ['Do I add sales tax, GST or HST to a commission?', 'It depends on where you work. In Canada a real estate commission is a taxable service, so a GST/HST-registered agent adds GST/HST at the rate for the province (see our Canada GST guide). In the US, sales tax on services is set by each state, so check your state before adding a tax line.'],
    ['Is there a real estate invoice template in Word or Excel?', 'Yes. Download the Word (.docx) or Excel (.xlsx) commission invoice above. The Excel version calculates the commission, split, tax and total for you.']
  ] : industry.custom === 'freelancer' ? [
    ['Is this freelance invoice template free to download?', 'Yes. The PDF, Word and Excel files are free and have no watermark. If you fill in the template online instead, the free PDF has a small "Created with GetInvoiceMaker.com" line at the bottom.'],
    ['What should a freelance invoice include?', 'Your name and contact details, the client\'s name and address, a unique invoice number, the invoice date and due date, each piece of work with hours or a fixed fee, any tax you charge, the total, and how to pay you.'],
    ['Should I bill hourly or per project?', 'Use whatever you agreed with the client. Hourly: one line per task with hours as the quantity. Project: one line per deliverable or milestone. Retainer: one line for the month, plus any extra work on separate lines.'],
    ['What payment terms should a freelancer use?', 'Common terms are due on receipt, 7, 14 or 30 days. Shorter terms usually mean faster payment. Write the due date on the invoice, not only "Net 30".'],
    ['Do I need a registered business to send an invoice?', 'In most countries a sole trader or self-employed person can invoice under their own name. See our guide to invoicing without a registered company for details.']
  ] : [];
%>
<script type="application/ld+json">
<%- JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebPage', name: industry.title, url: pageUrl, description: industry.desc, dateModified: '2026-10-07' },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl + '/' },
      { '@type': 'ListItem', position: 2, name: 'Invoice templates', item: siteUrl + '/#templates' },
      { '@type': 'ListItem', position: 3, name: industry.h1, item: pageUrl } ] }
  ].concat(faqs.length ? [{ '@type': 'FAQPage', mainEntity: faqs.map(function (f) { return { '@type': 'Question', name: f[0], acceptedAnswer: { '@type': 'Answer', text: f[1] } }; }) }] : [])
}).replace(/</g, '\\u003c') %>
</script>
</head>
<body>
<%- include('partials/nav') %>
<div class="crumbs"><a href="/">Home</a> › <a href="/#templates">Templates</a> › <%= industry.label %></div>

<section class="page-hero">
  <div class="in">
    <h1><%= industry.h1 %></h1>
    <p class="lede"><%= industry.intro %></p>
    <div class="btns">
      <a class="btn" href="#gen">Fill in the template</a>
      <% if (industry.custom) { %><a class="btn ghost" href="#download">Download Word, Excel or PDF</a><% } %>
    </div>
  </div>
</section>

<% if (industry.custom === 'real-estate') { %>
  <%- include('partials/industry-real-estate') %>
<% } else if (industry.custom === 'freelancer') { %>
  <%- include('partials/generator') %>
  <%- include('partials/industry-freelancer') %>
<% } else { %>
  <%- include('partials/generator') %>
  <div class="wrap prose">
    <h2>What a <%= industry.label.toLowerCase().replace(/s$/, '') %> invoice should include</h2>
    <p>Every invoice needs the basics: your name and contact details, the client's name and address, a unique invoice number, the invoice and due dates, the work with quantities and rates, any tax, the total and how to pay. For <%= industry.label.toLowerCase() %>, also add:</p>
    <ul>
      <% industry.fields.forEach(function(f){ %><li><%= f %></li><% }) %>
    </ul>

    <h2>Example lines</h2>
    <p>The generator above starts with these sample lines. Replace them with your own.</p>
    <table class="tbl">
      <thead><tr><th>Description</th><th class="num">Qty</th><th class="num">Rate</th><th class="num">Amount</th></tr></thead>
      <tbody>
        <% var sub = 0; industry.items.forEach(function(it){ var amt = it.qty * it.rate; sub += amt; %>
        <tr><td><%= it.desc %></td><td class="num"><%= it.qty %></td><td class="num"><%= it.rate.toFixed(2) %></td><td class="num"><%= amt.toFixed(2) %></td></tr>
        <% }) %>
        <tr><td class="strong">Subtotal before tax</td><td></td><td></td><td class="num strong"><%= sub.toFixed(2) %></td></tr>
      </tbody>
    </table>

    <h2>Tip</h2>
    <p><%= industry.tip %></p>

    <h2>Related</h2>
    <ul class="linklist">
      <li><a href="/how-to-invoice-as-a-freelancer">How to invoice as a freelancer</a></li>
      <li><a href="/blog/invoice-payment-terms-guide">Invoice payment terms</a></li>
      <li><a href="/how-to-charge-late-payment-fee">How to charge a late payment fee</a></li>
      <li><a href="/blog/invoice-number-format">How to number invoices</a></li>
    </ul>
  </div>
<% } %>

<% if (faqs.length) { %>
<div class="wrap prose" style="padding-top:0">
  <h2>Questions</h2>
  <div class="faq">
    <% faqs.forEach(function(f){ %><details><summary><%= f[0] %></summary><p><%= f[1] %></p></details><% }) %>
  </div>
</div>
<% } %>

<div class="wrap prose" style="padding-top:0">
  <h2>Other invoice templates</h2>
  <ul class="linklist">
    <% industries.filter(function(i){ return i.slug !== industry.slug; }).forEach(function(ind){ %><li><a href="/invoice-template-<%= ind.slug %>"><%= ind.h1 %></a></li><% }) %>
  </ul>
</div>

<%- include('partials/footer') %>
</body>
</html>
