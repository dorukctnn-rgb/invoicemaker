<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= page.title %> | GetInvoiceMaker</title>
<meta name="description" content="<%= page.desc %>">
<link rel="canonical" href="<%= siteUrl %>/<%= page.slug %>">
<meta property="og:type" content="article">
<meta property="og:title" content="<%= page.title %>">
<meta property="og:description" content="<%= page.desc %>">
<meta property="og:url" content="<%= siteUrl %>/<%= page.slug %>">
<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Article", "headline": page.title, "description": page.desc, "dateModified": page.updated, "mainEntityOfPage": siteUrl + "/" + page.slug,
      "author": { "@type": "Organization", "name": "GetInvoiceMaker", "url": siteUrl }, "publisher": { "@type": "Organization", "name": "GetInvoiceMaker", "url": siteUrl } },
    { "@type": "HowTo", "name": page.title, "step": (page.steps || []).map(function (t, i) { return { "@type": "HowToStep", "position": i + 1, "name": t, "text": t }; }) },
    { "@type": "BreadcrumbList", "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl + "/" },
      { "@type": "ListItem", "position": 2, "name": "Guides", "item": siteUrl + "/blog" },
      { "@type": "ListItem", "position": 3, "name": page.title, "item": siteUrl + "/" + page.slug } ] }
  ]
}) %>
</script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Inter',sans-serif;background:#f8fafc;color:#0f172a}
a{color:#2563eb;text-decoration:none}
nav{background:#fff;border-bottom:1px solid #e2e8f0;padding:0 32px;display:flex;justify-content:space-between;align-items:center;height:60px;position:sticky;top:0;z-index:100}
.logo{font-weight:700;font-size:18px}.logo span{color:#2563eb}
.nav-r{display:flex;gap:8px;align-items:center}
.nav-r a{color:#64748b;font-size:13px;padding:6px 12px;border-radius:6px}
.nav-r a:hover{background:#f1f5f9}
.btn-blue{background:#2563eb;color:#fff;border:none;padding:8px 18px;border-radius:6px;font-size:13px;font-weight:600;cursor:pointer}
.breadcrumb{padding:12px 32px;font-size:12px;color:#94a3b8;background:#fff;border-bottom:1px solid #f1f5f9}
.breadcrumb a{color:#2563eb}
.hero{background:#fff;border-bottom:1px solid #e2e8f0;padding:48px 24px 40px;text-align:center}
.hero h1{font-size:clamp(22px,4vw,36px);font-weight:700;margin-bottom:12px}
.hero p{color:#475569;font-size:15px;max-width:540px;margin:0 auto 24px}
.main{max-width:720px;margin:0 auto;padding:40px 20px}
.step-box{background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:24px;margin-bottom:16px}
.step-num{width:28px;height:28px;background:#2563eb;color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;margin-bottom:12px}
.step-box h3{font-size:15px;font-weight:600;margin-bottom:8px}
.step-box p{font-size:14px;color:#475569;line-height:1.7}
.cta-box{background:#eff6ff;border:1px solid #bfdbfe;border-radius:12px;padding:24px;margin:32px 0;text-align:center}
.cta-box h3{font-size:16px;font-weight:700;margin-bottom:8px}
.cta-box p{font-size:13px;color:#475569;margin-bottom:16px}
.article{background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:28px 28px 12px;line-height:1.75;font-size:15px;color:#334155}
.article h2{font-size:19px;font-weight:700;color:#0f172a;margin:26px 0 10px}
.article h2:first-child{margin-top:0}
.article p,.article ul,.article ol,.article table{margin-bottom:14px}
.article ul,.article ol{padding-left:20px}
.article li{margin-bottom:6px}
.article strong{color:#0f172a}
.article code{background:#f1f5f9;padding:1px 6px;border-radius:4px;font-size:13px}
.article table{width:100%;border-collapse:collapse;font-size:14px}
.article th,.article td{border:1px solid #e2e8f0;padding:8px 10px;text-align:left;vertical-align:top}
.article th{background:#f8fafc;font-size:12px;text-transform:uppercase;letter-spacing:.3px;color:#475569}
.summary{background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;padding:18px 20px;margin-bottom:20px}
.summary h2{font-size:13px;text-transform:uppercase;letter-spacing:.5px;color:#64748b;margin-bottom:10px}
.summary ol{padding-left:18px;font-size:14px;color:#0f172a;line-height:1.7}
.updated{font-size:12px;color:#94a3b8;margin-top:10px}
.guides{margin-top:32px}
.guides h2{font-size:18px;font-weight:700;margin-bottom:12px}
.guides a{display:block;padding:10px 0;border-bottom:1px solid #e2e8f0;font-size:14px}
@media(max-width:600px){.article{padding:20px 18px 6px}}
.templates{margin-top:40px}
.templates h2{font-size:18px;font-weight:700;margin-bottom:16px}
.tgrid{display:flex;flex-wrap:wrap;gap:8px}
.tlink{background:#fff;border:1px solid #e2e8f0;padding:6px 14px;border-radius:50px;font-size:12px;color:#475569}
.tlink:hover{background:#eff6ff;border-color:#2563eb;color:#2563eb}
footer{background:#0f172a;color:#94a3b8;padding:28px 20px;text-align:center;font-size:12px;margin-top:48px}
footer a{color:#64748b;margin:0 10px}
footer a:hover{color:#fff}
</style>
<%- include('partials/head') %>
</head>
<body>
<nav>
  <a href="/"><div class="logo">Get<span>Invoice</span>Maker</div></a>
  <div class="nav-r">
    <a href="/">Tool</a>
    <a href="/blog">Blog</a>
    <a href="/#pricing"><button class="btn-blue">Get PRO</button></a>
  </div>
</nav>
<div class="breadcrumb"><a href="/">Home</a> › <a href="/blog">Guides</a> › <%= page.title %></div>
<section class="hero">
  <h1><%= page.title %></h1>
  <p><%= page.desc %></p>
  <a href="/"><button class="btn-blue" style="font-size:14px;padding:10px 24px">Create Free Invoice Now</button></a>
</section>
<div class="main">
  <% if (page.steps && page.steps.length) { %>
  <div class="summary">
    <h2>In short</h2>
    <ol><% page.steps.forEach(function (t) { %><li><%= t %></li><% }) %></ol>
  </div>
  <% } %>
  <article class="article"><%- page.body %></article>
  <p class="updated">Last reviewed <%= page.updated %></p>
  <div class="cta-box">
    <h3>Ready to create your invoice?</h3>
    <p>Free, no signup, instant PDF download. Professional invoices in 60 seconds.</p>
    <a href="/"><button class="btn-blue" style="font-size:14px;padding:10px 24px">Create Free Invoice</button></a>
  </div>
  <div class="guides">
    <h2>More invoicing guides</h2>
    <% howTo.filter(function (h) { return h.slug !== page.slug; }).slice(0, 5).forEach(function (h) { %>
    <a href="/<%= h.slug %>"><%= h.title %></a>
    <% }) %>
    <a href="/how-to-calculate-gst-on-canadian-invoices">How to calculate GST on Canadian invoices</a>
  </div>
  <div class="templates">
    <h2>Free invoice templates</h2>
    <div class="tgrid">
      <% industries.slice(0,10).forEach(function(ind) { %>
      <a href="/invoice-template-<%= ind.slug %>" class="tlink"><%= ind.label %></a>
      <% }) %>
    </div>
  </div>
</div>
<footer>
  <a href="/">Home</a><a href="/blog">Blog</a><a href="/#pricing">Pricing</a>
  <p style="margin-top:12px">&#169; 2026 GetInvoiceMaker — Free Invoice Generator</p>
</footer>

</body>
</html>

