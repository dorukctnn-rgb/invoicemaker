<%
  var pageUrl = siteUrl + '/free-invoice-generator-uae';
  var checked = '17 October 2026';
  var ex = example, exd = exampleData;
  var FTA = {
    law: 'https://tax.gov.ae//Datafolder/Files/Legislation/2025/Federal%20Decree-Law%20No.%208%20of%202017%20and%20amendments%20-%20publishing%2028%2011%202025.pdf',
    reg: 'https://tax.gov.ae//Datafolder/Files/Legislation/2026/Law-No-8-of-2017-and-its-amendments--09-2026.pdf',
    registration: 'https://tax.gov.ae/en/taxes/Vat/vat.topics/registration.for.vat.aspx',
    einvoicing: 'https://tax.gov.ae/en/content/uae.einvoicing.aspx',
    md244: 'https://tax.gov.ae/Datafolder/Files/Pdf/2026/E-invoicing/Ministerial-Decision-No.-244-of-2025-on-the-Implementation-of-the-Electronic-Invoicing-System.pdf',
    tpl: 'https://tax.gov.ae//Datafolder/Files/Legislation/2025/Federal%20Decree-Law%20No.%2028%20of%202022%20-%20publishing%2003%2012%202025.pdf',
    legislation: 'https://tax.gov.ae/en/legislation.aspx'
  };
  var faqs = [
    ['What must a UAE tax invoice include?', 'The words "Tax Invoice"; your name, address and TRN; the customer\'s name, address and TRN if it is registered; a sequential or unique invoice number; the date of issue and the date of supply if different; a description of what you supplied; for each item the unit price, quantity, VAT rate and amount payable in AED; any discount; the gross amount and the VAT in AED, with the exchange rate if you invoice in another currency; and a reverse charge statement where it applies (Executive Regulation, Article 59(1)).'],
    ['What is the VAT rate in the UAE?', 'The standard rate is 5% (Federal Decree-Law No. 8 of 2017, Article 3). Zero-rated supplies are invoiced at 0%, and exempt supplies carry no VAT.'],
    ['Can I issue a tax invoice without a TRN?', 'No. A tax invoice must show the supplier\'s Tax Registration Number, and only a VAT-registered business issues one. If you are not registered, issue an ordinary invoice without VAT: under Article 65 of the Decree-Law, anyone who issues a tax invoice or collects an amount as VAT must pay that amount to the FTA.'],
    ['When can I use a simplified tax invoice?', 'When the customer is not registered for VAT, or when it is registered and the consideration is no more than AED 10,000, and never when the reverse charge applies (Executive Regulation, Article 59(5)). A simplified tax invoice is issued on the date of supply.'],
    ['How long do I have to issue a tax invoice?', '14 days from the date of supply (Decree-Law Article 67 and Executive Regulation Article 59(13)). A summary tax invoice for several supplies to the same customer is due within 14 days of the end of the month in which they were made.'],
    ['Can a UAE tax invoice be in US dollars?', 'Yes, but the amounts must also be converted into UAE dirhams at the Central Bank of the UAE exchange rate on the date of supply, and the invoice must show the VAT in AED and the exchange rate used (Decree-Law Article 69, Executive Regulation Article 59(1)(k)).'],
    ['Does a tax invoice have to be in Arabic?', 'Not to be issued. The Tax Procedures Law (Article 5) says records submitted to the FTA are in Arabic, but the FTA may accept another language if you provide an Arabic translation when it asks for one.'],
    ['Is a PDF tax invoice an e-invoice?', 'No. The FTA says PDF, Word documents, images, scanned copies and emails are not e-invoices. Businesses with revenue of AED 50 million or more must use the e-invoicing system from 1 January 2027 and the others from 1 July 2027 (Ministerial Decision No. 244 of 2025); until your date, a PDF tax invoice like this one is how you invoice.']
  ];
%><!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Free UAE Tax Invoice Generator: VAT 5%, TRN, AED</title>
<meta name="description" content="Make a UAE tax invoice with every Article 59 detail: the words Tax Invoice, both TRNs, VAT at 5% on each line and amounts in AED. Print or save as PDF, free.">
<link rel="canonical" href="<%= pageUrl %>">
<meta property="og:type" content="website">
<meta property="og:title" content="Free UAE Tax Invoice Generator (VAT 5%, TRN, AED)">
<meta property="og:description" content="A UAE tax invoice with the words Tax Invoice, both TRNs, VAT per line and amounts in AED. Print or save as PDF.">
<meta property="og:url" content="<%= pageUrl %>">
<%- include('partials/site-head') %>
<script type="application/ld+json">
<%- JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebPage', name: 'UAE tax invoice generator', url: pageUrl, description: 'Free UAE tax invoice generator with the Article 59 particulars, VAT at 5% per line and amounts in AED, plus the rules for simplified tax invoices, timing, foreign currency and e-invoicing.', dateModified: '2026-10-17', inLanguage: 'en',
      citation: [FTA.law, FTA.reg, FTA.registration, FTA.einvoicing, FTA.md244] },
    { '@type': 'WebApplication', name: 'UAE tax invoice generator', url: pageUrl + '#maker', applicationCategory: 'BusinessApplication', operatingSystem: 'Any (web browser)', offers: { '@type': 'Offer', price: '0', priceCurrency: 'AED' } },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl + '/' },
      { '@type': 'ListItem', position: 2, name: 'UAE tax invoice generator', item: pageUrl } ] },
    { '@type': 'FAQPage', mainEntity: faqs.map(function (f) { return { '@type': 'Question', name: f[0], acceptedAnswer: { '@type': 'Answer', text: f[1] } }; }) }
  ]
}).replace(/</g, '\\u003c') %>
</script>
<style>
.page-hero h1{text-wrap:balance}
.ut{max-width:1180px;margin:0 auto;padding:28px 20px 8px;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,620px);gap:22px;align-items:start}
.ut > *{min-width:0}
.ut-form{background:#fff;border:1px solid var(--line);border-radius:12px;padding:22px}
.ut-form h2{font-size:18px;font-weight:700;margin:18px 0 10px;font-family:'Public Sans',system-ui,sans-serif}
.ut-form h2:first-child{margin-top:0}
.ut-form .hint{font-size:13.5px;color:var(--muted);margin:-4px 0 12px}
.ut-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px 12px}
.ut-f{display:block;margin-bottom:10px}
.ut-f > span,.ut-line label > span{display:block;font-size:12.5px;font-weight:600;color:#475569;margin-bottom:4px}
.ut-f input,.ut-f select,.ut-f textarea,.ut-line input,.ut-line select{width:100%;min-width:0;border:1px solid #cbd5e1;border-radius:7px;padding:10px 11px;font-size:16px;font-family:inherit;background:#fff;color:var(--ink)}
.ut-f textarea{resize:vertical}
.ut-f input:focus,.ut-f select:focus,.ut-f textarea:focus,.ut-line input:focus,.ut-line select:focus{outline:none;border-color:var(--blue);box-shadow:0 0 0 3px rgba(37,99,235,.12)}
