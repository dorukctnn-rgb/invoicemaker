<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex, follow">
<title>Activate Pro | GetInvoiceMaker</title>
<%- include('partials/site-head') %>
<style>
.act{max-width:460px;margin:40px auto;padding:0 16px}
.act .card{padding:28px}
.act h1{font-size:24px;margin-bottom:8px}
.act p{color:var(--ink2);font-size:15px;margin-bottom:16px}
.act label{display:block;font-size:12px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;margin-bottom:6px}
.act input{width:100%;border:1px solid var(--line);border-radius:8px;padding:11px 13px;font-size:16px;font-family:ui-monospace,Menlo,Consolas,monospace;margin-bottom:12px}
.act input:focus{outline:none;border-color:var(--blue);box-shadow:0 0 0 3px rgba(37,99,235,.12)}
.act .btn{width:100%}
.msg{margin-top:14px;padding:11px 14px;border-radius:8px;font-size:14px;display:none}
.msg.ok{display:block;background:#dcfce7;color:#166534}
.msg.err{display:block;background:#fee2e2;color:#991b1b}
.act .small{font-size:13px;color:var(--muted);margin-top:16px}
.linkbtn{background:none;border:0;color:var(--blue);cursor:pointer;font:inherit;padding:0;text-decoration:underline}
</style>
</head>
<body>
<%- include('partials/nav') %>
<div class="act">
  <div class="card">
    <% if (isPro) { %>
      <h1>Pro is active</h1>
      <p>Your PDFs are created without the "Created with GetInvoiceMaker" line, and your logo is added when you upload one.</p>
      <a class="btn" href="/#gen">Create an invoice</a>
      <p class="small">On a shared computer? <button type="button" class="linkbtn" id="deact">Remove Pro from this browser</button></p>
    <% } else { %>
      <h1>Activate Pro</h1>
      <p>Paste the license key from your Gumroad receipt email. Pro is then active in this browser; repeat on any other device you use.</p>
      <label for="key">License key</label>
      <input type="text" id="key" autocomplete="off" spellcheck="false" placeholder="XXXXXXXX-XXXXXXXX-XXXXXXXX-XXXXXXXX">
      <button type="button" class="btn" id="go">Activate Pro</button>
      <div class="msg" id="msg" role="status"></div>
      <p class="small">Bought Pro before October 2026 and activated with your email? Activation now uses the license key, which you can find in your Gumroad receipt or library. <% if (checkout.available) { %>No key yet? <a href="/#pricing">See Pro</a>.<% } %></p>
    <% } %>
  </div>
</div>
<%- include('partials/footer') %>
<script>
(function(){
  var go=document.getElementById('go');
  if(go){
    var msg=document.getElementById('msg');
    function show(ok,t){msg.className='msg '+(ok?'ok':'err');msg.textContent=t;}
    go.addEventListener('click',function(){
      var k=document.getElementById('key').value.trim();
      if(!k){show(false,'Paste your license key first.');return;}
      go.disabled=true;go.textContent='Checking with Gumroad...';
      fetch('/activate-pro',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({license_key:k})})
        .then(function(r){return r.json();})
        .then(function(d){
          if(d.success){try{localStorage.setItem('gim_license',k);}catch(e){}show(true,'Pro is active. Taking you to the generator...');setTimeout(function(){location.href='/#gen';},1200);}
          else{show(false,d.message||'That key did not work.');go.disabled=false;go.textContent='Activate Pro';}
        })
        .catch(function(){show(false,'Network error. Please try again.');go.disabled=false;go.textContent='Activate Pro';});
    });
  }
  var de=document.getElementById('deact');
  if(de){de.addEventListener('click',function(){try{localStorage.removeItem('gim_license');}catch(e){}fetch('/deactivate-pro',{method:'POST'}).then(function(){location.reload();});});}
})();
</script>
</body>
</html>
