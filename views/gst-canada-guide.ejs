      author: { '@type': 'Organization', name: 'GetInvoiceMaker', url: siteUrl + '/' }, publisher: { '@type': 'Organization', name: 'GetInvoiceMaker', url: siteUrl + '/' },
      citation: [S.cra.url, S.craItc.url, S.craRegister.url, S.craPlace.url, S.bc.url, S.sk.url, S.mb.url, S.qc.url] },
