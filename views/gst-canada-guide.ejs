.calc .btn{margin-top:14px}
.inv{background:#fff;border:1px solid #cbd5e1;border-radius:10px;padding:22px;font-size:13.5px;margin:14px 0 6px}
.inv .top{display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;border-bottom:2px solid var(--blue);padding-bottom:12px;margin-bottom:12px}
.inv .k{color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.5px}
.inv table{width:100%;border-collapse:collapse;margin:10px 0}
.inv th{background:#f1f5f9;text-align:left;padding:7px 8px;font-size:11px;text-transform:uppercase;color:#475569}
.inv td{padding:7px 8px;border-bottom:1px solid #f1f5f9}
.inv .r{text-align:right;white-space:nowrap}
