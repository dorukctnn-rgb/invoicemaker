<%
  var isCA = country.slug === 'canada';
  var title = isCA ? 'Canadian Invoice Generator: GST/HST by Province (Free)' : 'Free Invoice Generator for ' + country.fullName + ' (' + country.currency + ' PDF)';
  var h1 = isCA ? 'Canadian Invoice Generator with GST/HST by Province' : 'Free Invoice Generator for ' + country.fullName;
  var pageUrl = siteUrl + '/free-invoice-generator-' + country.slug;
%><!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= title %></title>
<meta name="description" content="<%= country.desc %>">
<link rel="canonical" href="<%= pageUrl %>">
<meta property="og:type" content="website">
<meta property="og:title" content="<%= title %>">
<meta property="og:description" content="<%= country.desc %>">
<meta property="og:url" content="<%= pageUrl %>">
<%- include('partials/site-head') %>
<script type="application/ld+json">
<%- JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebApplication', name: h1, url: pageUrl, description: country.desc, applicationCategory: 'BusinessApplication', operatingSystem: 'Any (web browser)', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' } },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl + '/' },
      { '@type': 'ListItem', position: 2, name: country.fullName, item: pageUrl } ] }
  ]
}).replace(/</g, '\\u003c') %>
</script>
</head>
<body>
<%- include('partials/nav') %>
<div class="crumbs"><a href="/">Home</a> › <a href="/#templates">By country</a> › <%= country.fullName %></div>

<section class="page-hero">
  <div class="in">
    <h1><%= h1 %></h1>
    <p class="lede"><%= country.intro %></p>
    <div class="facts"><span><%= country.currency %> pre-selected</span><span><%= isCA ? 'GST, HST, PST, RST and QST' : country.tax + ' line' %></span><span>Free PDF, no signup</span></div>
  </div>
</section>

<%- include('partials/generator') %>

<div class="wrap prose">
<% if (isCA) { %>
  <h2>Which tax lines a Canadian invoice gets</h2>
  <p>The rate depends on the province where you make the sale, which for most services is the province of your client's address. Pick that province above and the generator fills in the lines below.</p>
  <table class="tbl">
    <thead><tr><th>Province or territory</th><th>Tax lines on the invoice</th><th class="num">Total rate</th></tr></thead>
    <tbody>
      <% canada.PROVINCES.forEach(function(p){ var pp = provinces.filter(function(x){ return x.code === p.code; })[0]; %>
      <tr><td class="strong"><% if (pp) { %><a href="/<%= pp.slug %>"><%= p.name %></a><% } else { %><%= p.name %><% } %></td><td><%= p.summary %></td><td class="num"><%= p.total %>%</td></tr>
      <% }) %>
    </tbody>
  </table>
  <p class="source">Rates last checked <%= canada.RATES_CHECKED %> against the <a href="<%= canada.SOURCES.cra.url %>" rel="noopener">CRA GST/HST rates table</a> and the provincial tax sites. Nova Scotia's HST is 14% since 1 April 2025.</p>
  <p>For the formulas, worked examples and the information the CRA expects on an invoice, read <a href="/how-to-calculate-gst-on-canadian-invoices">how to calculate GST on Canadian invoices</a>.</p>
<% } else { %>
  <h2><%= country.tax %> on invoices in <%= country.fullName %></h2>
  <% if (country.about) { %><p><%= country.about %></p><% } %>
  <% if (country.source) { %><p class="source">Standard rate checked <%= ratesChecked %> against <a href="<%= country.source.url %>" rel="noopener"><%= country.source.name %></a>. Rates change; check the rate for your specific goods or services.</p><% } %>
<% } %>

  <h2>How to create a <%= country.fullName %> invoice here</h2>
  <ol>
    <li>Enter your business name and address, and your <%= country.idLabel || 'tax ID' %> if you have one.</li>
    <li>Add your client and one line per service or product, with quantity and rate in <%= country.currency %>.</li>
    <li><%= isCA ? 'Choose the province to fill in GST, HST or GST + PST/QST.' : 'Check the ' + country.tax + ' rate, or clear it if you do not charge ' + country.tax + '.' %></li>
    <li>Put your bank details and payment terms in the notes.</li>
    <li>Download the PDF and email it to your client.</li>
  </ol>

  <h2>Invoice generators for other countries</h2>
  <ul class="linklist">
    <% countries.filter(function(c){ return c.slug !== country.slug; }).forEach(function(c){ %><li><a href="/free-invoice-generator-<%= c.slug %>"><%= c.fullName %> (<%= c.currency %>)</a></li><% }) %>
  </ul>
</div>

<%- include('partials/footer') %>
</body>
</html>
