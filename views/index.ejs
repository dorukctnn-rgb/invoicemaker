  </div>

  <!-- Trip list + summary -->
  <div>
    <div class="panel">
      <h2>Trips (<span id="tripCount">0</span>)</h2>
      <div class="trip-list" id="tripList">
        <div class="empty">No trips added yet. Add your first trip on the left.</div>
      </div>
      <button class="btn" id="generateBtn" onclick="generatePDF()" style="margin-top:16px;width:100%">Generate IRS-Ready PDF</button>
    </div>

    <div class="summary">
      <h3>Tax Deduction Summary</h3>
      <div class="summary-row"><span>Business miles</span><span id="sumBusiness">0.0 mi</span></div>
      <div class="summary-row"><span>Medical miles</span><span id="sumMedical">0.0 mi</span></div>
      <div class="summary-row"><span>Charity miles</span><span id="sumCharity">0.0 mi</span></div>
      <div class="summary-row"><span>Total Deduction</span><span id="sumTotal">$0.00</span></div>
    </div>
  </div>
</div>

