      <input type="text" id="userName" placeholder="John Doe">
    </div>
    <div class="field">
      <label>Vehicle</label>
      <input type="text" id="userVehicle" placeholder="2022 Toyota Camry">
    </div>
    <div class="row2">
      <div class="field">
        <label>Starting Odometer</label>
        <input type="number" id="startOdo" placeholder="45000">
      </div>
      <div class="field">
        <label>Ending Odometer</label>
