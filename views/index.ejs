      </div>
    </div>
    <div class="field">
      <label>Tax Year</label>
      <select id="taxYear">
        <option value="2026">2026 (72.5¢/mi)</option>
        <option value="2025">2025 (70¢/mi)</option>
        <option value="2024">2024 (67¢/mi)</option>
