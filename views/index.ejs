<!-- PRO UPGRADE MODAL -->
<div class="modal-overlay" id="proModal">
  <div class="modal">
    <button class="modal-close" onclick="closeProModal()">×</button>
    <h2>MileageLogMaker Pro</h2>
    <p class="modal-sub">One payment. Lifetime access. No subscription.</p>

