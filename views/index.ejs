<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %></title>
<meta name="description" content="<%= description %>">
<meta property="og:title" content="<%= title %>">
<meta property="og:description" content="<%= description %>">
<meta name="google-site-verification" content="lTAZNAqExJcgGVTl7hfH3sdplbLhtLtfScgj18hkzO4" />
<link rel="canonical" href="https://mileagelogmaker.com/">
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#f7f9fc;color:#0a2540;line-height:1.5}
.nav{background:#fff;border-bottom:1px solid #e6ebf1;padding:14px 0}
.nav-inner{max-width:1200px;margin:0 auto;padding:0 20px;display:flex;justify-content:space-between;align-items:center}
.logo{font-size:18px;font-weight:700;color:#0a2540;text-decoration:none}
.nav-links a{color:#425466;text-decoration:none;margin-left:20px;font-size:14px}
.nav-links a:hover{color:#0a2540}
.hero{padding:60px 20px 40px;text-align:center;background:linear-gradient(180deg,#fff 0%,#f7f9fc 100%)}
.hero h1{font-size:42px;font-weight:800;margin-bottom:16px;letter-spacing:-1px}
.hero p{font-size:18px;color:#425466;max-width:680px;margin:0 auto 12px}
.hero .badge{display:inline-block;background:#e0f7e9;color:#0d8043;padding:6px 14px;border-radius:20px;font-size:13px;font-weight:600;margin-bottom:20px}
.rates{display:flex;justify-content:center;gap:24px;margin:24px 0;flex-wrap:wrap}
.rate-card{background:#fff;border:1px solid #e6ebf1;padding:14px 20px;border-radius:8px;font-size:14px}
.rate-card strong{color:#0a2540;font-size:18px;display:block}
.rate-card span{color:#635bff;font-weight:600}

.tool{max-width:1200px;margin:30px auto;padding:0 20px;display:grid;grid-template-columns:1fr 1fr;gap:24px}
@media(max-width:900px){.tool{grid-template-columns:1fr}}

.panel{background:#fff;border:1px solid #e6ebf1;border-radius:12px;padding:24px}
.panel h2{font-size:18px;margin-bottom:16px;font-weight:700}

.field{margin-bottom:14px}
.field label{display:block;font-size:13px;color:#425466;margin-bottom:6px;font-weight:500}
.field input,.field select{width:100%;padding:10px 12px;border:1px solid #e6ebf1;border-radius:6px;font-size:14px;font-family:inherit}
.field input:focus,.field select:focus{outline:none;border-color:#635bff;box-shadow:0 0 0 3px rgba(99,91,255,.1)}

.row2{display:grid;grid-template-columns:1fr 1fr;gap:12px}

.btn{background:#635bff;color:#fff;border:none;padding:11px 20px;border-radius:6px;font-size:14px;font-weight:600;cursor:pointer;font-family:inherit}
.btn:hover{background:#5048e5}
.btn-secondary{background:#fff;color:#635bff;border:1px solid #635bff}
.btn-secondary:hover{background:#f5f4ff}
.btn-danger{background:#fff;color:#d13438;border:1px solid #fadbdb;padding:6px 10px;font-size:12px}

.trip-list{margin-top:16px;max-height:400px;overflow-y:auto}
.trip-item{background:#f7f9fc;padding:12px;border-radius:6px;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center;font-size:13px}
.trip-item .info{flex:1}
.trip-item .info strong{display:block;color:#0a2540}
.trip-item .info span{color:#425466;font-size:12px}
.trip-item .miles{color:#635bff;font-weight:700;margin:0 12px}

.summary{background:#0a2540;color:#fff;padding:24px;border-radius:12px;margin-top:24px}
.summary h3{font-size:16px;margin-bottom:14px;font-weight:600;opacity:.8}
.summary-row{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid rgba(255,255,255,.1);font-size:14px}
.summary-row:last-child{border:none;font-size:18px;font-weight:700;padding-top:14px;margin-top:6px;border-top:2px solid rgba(255,255,255,.2)}

.empty{text-align:center;color:#8898aa;padding:40px 20px;font-size:14px}

/* Pro modal */
.modal-overlay{display:none;position:fixed;inset:0;background:rgba(10,37,64,.7);z-index:100;align-items:center;justify-content:center;padding:20px}
.modal-overlay.active{display:flex}
.modal{background:#fff;border-radius:14px;max-width:440px;width:100%;padding:32px;position:relative}
.modal-close{position:absolute;top:14px;right:14px;background:none;border:none;font-size:24px;color:#8898aa;cursor:pointer;width:32px;height:32px;border-radius:50%}
.modal-close:hover{background:#f7f9fc}
.modal h2{font-size:24px;margin-bottom:8px;font-weight:700}
.modal .modal-sub{color:#425466;font-size:14px;margin-bottom:24px}
.modal .price{display:flex;align-items:baseline;gap:8px;margin:18px 0}
.modal .price .amt{font-size:42px;font-weight:800;color:#0a2540}
.modal .price .desc{color:#635bff;font-weight:600;font-size:14px}
.modal .features{list-style:none;margin:18px 0 24px}
.modal .features li{padding:8px 0 8px 28px;position:relative;color:#0a2540;font-size:14px}
.modal .features li:before{content:"✓";position:absolute;left:0;top:8px;color:#0d8043;font-weight:700;font-size:16px}
.modal-btn{display:block;width:100%;background:#635bff;color:#fff;text-align:center;padding:14px;border-radius:8px;text-decoration:none;font-weight:600;font-size:15px;border:none;cursor:pointer;font-family:inherit}
.modal-btn:hover{background:#5048e5}
.modal .or{text-align:center;color:#8898aa;margin:18px 0;font-size:13px}
.modal input[type="email"]{width:100%;padding:12px;border:1px solid #e6ebf1;border-radius:6px;font-size:14px;font-family:inherit;margin-bottom:8px}
.modal input[type="email"]:focus{outline:none;border-color:#635bff}
.modal-status{font-size:13px;margin-top:8px;text-align:center}
.modal-status.error{color:#d13438}
.modal-status.success{color:#0d8043}

.pro-badge{display:inline-block;background:linear-gradient(135deg,#FFD700,#FFA500);color:#0a2540;padding:4px 10px;border-radius:12px;font-size:11px;font-weight:700;margin-left:8px;vertical-align:middle}
.pro-only-link{color:#635bff;cursor:pointer;text-decoration:underline;font-size:13px}
.pro-only-link:hover{color:#5048e5}

.section{max-width:900px;margin:60px auto;padding:0 20px}
.section h2{font-size:28px;margin-bottom:16px;font-weight:700}
.section p{color:#425466;margin-bottom:14px;font-size:16px}
.feature-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:30px}
@media(max-width:700px){.feature-grid{grid-template-columns:1fr}}
.feature{background:#fff;padding:24px;border-radius:8px;border:1px solid #e6ebf1}
.feature h3{font-size:16px;margin-bottom:8px}
.feature p{font-size:14px;color:#425466;margin:0}

.niche-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:24px}
@media(max-width:700px){.niche-grid{grid-template-columns:1fr}}
.niche-card{background:#fff;border:1px solid #e6ebf1;padding:16px;border-radius:8px;text-decoration:none;color:#0a2540;transition:all .15s}
.niche-card:hover{border-color:#635bff;box-shadow:0 4px 12px rgba(99,91,255,.1)}
.niche-card strong{display:block;margin-bottom:4px;font-size:14px}
.niche-card span{font-size:12px;color:#8898aa}

footer{background:#0a2540;color:#a3b1cc;padding:30px 20px;text-align:center;margin-top:60px;font-size:13px}
footer a{color:#fff;text-decoration:none;margin:0 10px}
</style>
</head>
