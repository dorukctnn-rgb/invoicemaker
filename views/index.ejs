<script>
const RATES_2026 = { business: <%= rates.business %>, medical: <%= rates.medical %>, charity: <%= rates.charity %>, personal: 0 };
const RATES_2025 = { business: 0.70, medical: 0.21, charity: 0.14, personal: 0 };
const RATES_2024 = { business: 0.67, medical: 0.21, charity: 0.14, personal: 0 };

let trips = JSON.parse(localStorage.getItem('mileage_trips') || '[]');
let proEmail = localStorage.getItem('pro_email') || '';

function isProUser(){ return !!proEmail; }

function openProModal(){ document.getElementById('proModal').classList.add('active'); }
function closeProModal(){ document.getElementById('proModal').classList.remove('active'); document.getElementById('licenseStatus').textContent = ''; }

document.getElementById('proModal').addEventListener('click', function(e){
  if(e.target === this) closeProModal();
});

async function verifyLicense(){
  const email = document.getElementById('licenseEmail').value.trim();
  const status = document.getElementById('licenseStatus');
  if(!email){ status.textContent = 'Please enter your email'; status.className = 'modal-status error'; return; }

  status.textContent = 'Checking...'; status.className = 'modal-status';
  try{
    const res = await fetch('/verify-pro', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email })
    });
    const data = await res.json();
    if(data.pro){
      proEmail = data.email;
      localStorage.setItem('pro_email', proEmail);
      status.textContent = '✓ Pro unlocked! Refreshing...';
      status.className = 'modal-status success';
      setTimeout(()=>location.reload(), 1000);
    } else {
      status.textContent = 'Email not found. If you purchased recently, wait a minute and retry.';
      status.className = 'modal-status error';
    }
  } catch(e){
    status.textContent = 'Connection error. Try again.';
    status.className = 'modal-status error';
  }
}

function updateProUI(){
  if(isProUser()){
    const btn = document.getElementById('navProBtn');
    if(btn){ btn.innerHTML = '✓ Pro'; btn.style.background = '#0d8043'; btn.onclick = function(){ if(confirm('Sign out of Pro on this device?')){ localStorage.removeItem('pro_email'); proEmail=''; location.reload(); } }; }
  }
}

function save(){ localStorage.setItem('mileage_trips', JSON.stringify(trips)); }

function addTrip(){
  const t = {
    date: document.getElementById('tripDate').value,
    start: document.getElementById('tripStart').value,
    end: document.getElementById('tripEnd').value,
    purpose: document.getElementById('tripPurpose').value,
    miles: parseFloat(document.getElementById('tripMiles').value) || 0,
    type: document.getElementById('tripType').value
  };

  if(!t.date || !t.miles){
    alert('Please enter at least a date and miles.');
    return;
  }

  trips.push(t);
  save();
  render();

  // Reset
  document.getElementById('tripStart').value = '';
  document.getElementById('tripEnd').value = '';
  document.getElementById('tripPurpose').value = '';
  document.getElementById('tripMiles').value = '';
}

function removeTrip(i){
  trips.splice(i, 1);
  save();
  render();
}

function render(){
  const list = document.getElementById('tripList');
  document.getElementById('tripCount').textContent = trips.length;

  if(trips.length === 0){
    list.innerHTML = '<div class="empty">No trips added yet. Add your first trip on the left.</div>';
  } else {
    list.innerHTML = trips.map((t,i) => `
      <div class="trip-item">
        <div class="info">
          <strong>${t.date}: ${t.start || '?'} → ${t.end || '?'}</strong>
          <span>${t.purpose || 'No purpose'} • ${t.type}</span>
        </div>
        <div class="miles">${t.miles} mi</div>
        <button class="btn-danger" onclick="removeTrip(${i})">×</button>
      </div>
    `).join('');
  }

  // Summary
  const year = document.getElementById('taxYear').value;
  const rates = year === '2024' ? RATES_2024 : (year === '2025' ? RATES_2025 : RATES_2026);
  const totals = { business: 0, medical: 0, charity: 0, personal: 0 };
  trips.forEach(t => { if(totals[t.type] !== undefined) totals[t.type] += t.miles; });

  document.getElementById('sumBusiness').textContent = `${totals.business.toFixed(1)} mi ($${(totals.business * rates.business).toFixed(2)})`;
  document.getElementById('sumMedical').textContent = `${totals.medical.toFixed(1)} mi ($${(totals.medical * rates.medical).toFixed(2)})`;
  document.getElementById('sumCharity').textContent = `${totals.charity.toFixed(1)} mi ($${(totals.charity * rates.charity).toFixed(2)})`;
  const total = totals.business * rates.business + totals.medical * rates.medical + totals.charity * rates.charity;
  document.getElementById('sumTotal').textContent = `$${total.toFixed(2)}`;
}

document.getElementById('taxYear').addEventListener('change', render);

async function generatePDF(){
  // KRİTİK: Trip yoksa kullanıcıyı uyar ve Add Trip'e yönlendir
  if(trips.length === 0){
    showNoTripsWarning();
    return;
  }

  const userInfo = {
    name: document.getElementById('userName').value,
    vehicle: document.getElementById('userVehicle').value,
    startOdometer: document.getElementById('startOdo').value,
    endOdometer: document.getElementById('endOdo').value,
    email: proEmail
  };
  const year = document.getElementById('taxYear').value;

  const btn = document.getElementById('generateBtn');
  btn.disabled = true;
  btn.textContent = 'Generating...';

  try{
    const res = await fetch('/generate-pdf', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ trips, userInfo, year })
    });

    if(!res.ok) throw new Error('PDF failed');

    const blob = await res.blob();
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `mileage-log-${year}.pdf`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);

    // Pro upgrade nudge after 5+ trips
    if(!isProUser() && trips.length >= 5){
      setTimeout(()=>openProModal(), 1200);
    }
  } catch(e){
    alert('Could not generate PDF. Try again.');
  }

  btn.disabled = false;
  btn.textContent = 'Generate IRS-Ready PDF';
}

// Show friendly warning when user clicks Generate without adding trips
function showNoTripsWarning(){
  // Scroll to Add Trip form
  const addTripSection = document.querySelector('.panel');
  if(addTripSection){
    addTripSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  // Highlight the Add Trip form temporarily
  const firstPanel = document.querySelectorAll('.panel')[0];
  if(firstPanel){
    firstPanel.style.boxShadow = '0 0 0 4px #ffcc00, 0 8px 24px rgba(255,204,0,0.4)';
    firstPanel.style.transition = 'box-shadow 0.3s';
    setTimeout(()=>{
      firstPanel.style.boxShadow = '';
    }, 3000);
  }

  // Show warning modal
  const existing = document.getElementById('noTripsModal');
  if(existing) existing.remove();

  const modal = document.createElement('div');
  modal.id = 'noTripsModal';
  modal.innerHTML = `
    <div style="position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:9999;display:flex;align-items:center;justify-content:center;padding:20px;animation:fadeIn 0.2s">
      <div style="background:#fff;max-width:440px;width:100%;padding:32px 28px;border-radius:16px;box-shadow:0 20px 60px rgba(0,0,0,0.3);text-align:center;animation:slideUp 0.3s">
        <div style="font-size:56px;margin-bottom:12px">⚠️</div>
        <h3 style="margin:0 0 12px;font-size:22px;color:#1a1a1a;font-weight:700">Add a trip first!</h3>
        <p style="margin:0 0 24px;color:#555;line-height:1.5;font-size:15px">
          You need to add at least <strong>one trip</strong> before generating your PDF mileage log.
        </p>
        <div style="background:#fff8e1;border:2px solid #ffcc00;border-radius:10px;padding:14px;margin-bottom:20px;text-align:left">
          <strong style="color:#856404;display:block;margin-bottom:6px;font-size:14px">📝 How to add a trip:</strong>
          <ol style="margin:0;padding-left:20px;color:#555;font-size:14px;line-height:1.6">
            <li>Fill in the <strong>"Add Trip"</strong> form on the left</li>
            <li>Enter date, locations, miles, and type</li>
            <li>Click <strong>"+ Add Trip"</strong> button</li>
            <li>Then come back here and generate PDF</li>
          </ol>
        </div>
        <button onclick="closeNoTripsWarning()" style="background:#0066ff;color:#fff;border:none;padding:13px 32px;border-radius:10px;font-size:16px;font-weight:600;cursor:pointer;width:100%">
          Got it, let's add a trip →
        </button>
      </div>
    </div>
    <style>
      @keyframes fadeIn { from { opacity: 0 } to { opacity: 1 } }
      @keyframes slideUp { from { transform: translateY(20px); opacity: 0 } to { transform: translateY(0); opacity: 1 } }
    </style>
  `;
  document.body.appendChild(modal);
}

function closeNoTripsWarning(){
  const modal = document.getElementById('noTripsModal');
  if(modal) modal.remove();
  // Focus on first trip input
  const startInput = document.getElementById('tripStart') || document.getElementById('tripDate');
  if(startInput) startInput.focus();
}

// Init
document.getElementById('tripDate').valueAsDate = new Date();
updateProUI();
render();
</script>

</body>
</html>
